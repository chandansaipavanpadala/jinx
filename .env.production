# Baked into `npm run build` for GitHub Pages (static demo).
# Seed user disabled so visitors can create their own profile on first visit.
# To re-enable a default account, set VITE_ALLOW_SEED_USER=true and fill in credentials.
VITE_ALLOW_SEED_USER=false
VITE_SEED_EMAIL=
VITE_SEED_PASSWORD=
VITE_SEED_DISPLAY_NAME=JINX Operator
VITE_PREFILL_LOGIN_EMAIL=false
