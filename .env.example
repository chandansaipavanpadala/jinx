# JINX environment (copy to .env.development for local dev)
# Vite exposes only variables prefixed with VITE_

# ── Database ──
# local = browser localStorage/sessionStorage (default)
# api   = REST backend (requires VITE_API_BASE_URL + server routes)
VITE_DB_DRIVER=local
# VITE_API_BASE_URL=https://api.example.com/v1

# ── Auth / seed user ──
# Local dev: use .env.development (gitignored).
# GitHub Pages: .env.production (committed demo account) or CI secrets below.
# VITE_ALLOW_SEED_USER=true
# VITE_SEED_EMAIL=admin@jinx.local
# VITE_SEED_PASSWORD=
# VITE_SEED_DISPLAY_NAME=JINX Operator
# VITE_PREFILL_LOGIN_EMAIL=true

# Session TTL overrides (optional)
# VITE_SESSION_HOURS=12
# VITE_REMEMBER_DAYS=30
